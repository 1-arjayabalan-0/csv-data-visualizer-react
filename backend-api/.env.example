# CSV Data Visualizer Backend API - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://username:password@localhost:5432/csv_visualizer"

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Secret key for signing JWT access tokens (use a strong, random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Secret key for signing JWT refresh tokens (use a different strong, random string)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# JWT token expiration times
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Google OAuth 2.0 Client ID (get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Google OAuth 2.0 Client Secret (get from Google Cloud Console)
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OAuth callback URL (should match your Google OAuth configuration)
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the API server to run on
PORT=3001

# Node.js environment (development, production, test)
NODE_ENV=development

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend application URL (for CORS and OAuth redirects)
FRONTEND_URL="http://localhost:3000"

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file size for CSV uploads (in bytes)
# 5MB = 5 * 1024 * 1024 = 5242880 bytes
MAX_FILE_SIZE=5242880

# Directory for storing uploaded files (relative to project root)
UPLOAD_DIR="uploads"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging (true/false)
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Enable HTTPS redirect in production (true/false)
ENFORCE_HTTPS=false

# Session secret for additional security (use a strong, random string)
SESSION_SECRET="your-session-secret-change-this-in-production"

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Enable rate limiting (true/false)
ENABLE_RATE_LIMITING=true

# Rate limit: requests per window
RATE_LIMIT_REQUESTS=100

# Rate limit: window duration in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable detailed error messages in development (true/false)
DETAILED_ERRORS=true

# Enable API documentation endpoint (true/false)
ENABLE_API_DOCS=true

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# When deploying to production, make sure to:
# 1. Change all secrets to strong, random values
# 2. Set NODE_ENV=production
# 3. Use a production database URL
# 4. Set FRONTEND_URL to your production domain
# 5. Configure proper CORS origins
# 6. Enable HTTPS enforcement
# 7. Set appropriate rate limits
# 8. Disable detailed errors and API docs

# Example production values:
# NODE_ENV=production
# FRONTEND_URL="https://your-app.com"
# CORS_ORIGINS="https://your-app.com"
# ENFORCE_HTTPS=true
# DETAILED_ERRORS=false
# ENABLE_API_DOCS=false
# LOG_LEVEL=warn