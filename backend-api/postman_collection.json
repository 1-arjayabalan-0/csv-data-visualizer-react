	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pre-request script for CSV Data Visualizer API",
					"// This script can be used to set up authentication tokens or other variables",
					"",
					"// Example: Set timestamp for requests",
					"pm.globals.set('timestamp', new Date().toISOString());",
					"",
					"// Log the current request for debugging",
					"console.log('Making request to:', pm.request.url.toString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script for CSV Data Visualizer API",
					"// This script runs after every request",
					"",
					"// Test for successful response structure",
					"if (pm.response.code === 200) {",
					"    pm.test('Response has correct structure', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('success');",
					"        pm.expect(jsonData).to.have.property('message');",
					"        pm.expect(jsonData).to.have.property('statusCode');",
					"        pm.expect(jsonData.success).to.be.true;",
					"    });",
					"}",
					"",
					"// Test for error response structure",
					"if (pm.response.code >= 400) {",
					"    pm.test('Error response has correct structure', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('success');",
					"        pm.expect(jsonData).to.have.property('message');",
					"        pm.expect(jsonData).to.have.property('statusCode');",
					"        pm.expect(jsonData.success).to.be.false;",
					"    });",
					"}",
					"",
					"// Log response time",
					"console.log('Response time:', pm.response.responseTime + 'ms');"
				]
			}
		}
